# Local development only. On Cloudflare the BACKEND service binding in
# wrangler.jsonc and the secrets set by deploy.yml's deploy-dashboard job are used
# instead, and none of this is needed.

# Required for local dev: URL of a reachable `backend` Worker (e.g. `wrangler dev`
# in the repo root). With neither this nor the binding, /api/* answers 503.
BACKEND_URL=

# Login, the same three values as the Worker secrets. All three must be set or
# the login answers 503.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
JWT_SECRET=

# Optional: session length in seconds (default 86400).
# SESSION_TTL_SECONDS=86400
