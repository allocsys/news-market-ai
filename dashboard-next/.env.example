# Local development only. On Cloudflare the BACKEND service binding in
# wrangler.jsonc and the secrets set by deploy-dashboard-next.yml are used
# instead, and none of this is needed.

# Optional: point the API at a reachable `backend` Worker (e.g. `wrangler dev`
# in the repo root). Leave empty for MOCK mode (canned data, any login works).
BACKEND_URL=

# Login for the real (BACKEND_URL) mode, the same three values as the Worker
# secrets. All three must be set or the login answers 503.
# In mock mode, if both username and password are set the mock login checks them.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
JWT_SECRET=

# Optional: session length in seconds (default 86400).
# SESSION_TTL_SECONDS=86400

# Production safety: mock data is refused in production unless this is 1.
# ALLOW_MOCK=0
