# Wire the dashboard to your real news-market-ai backend.
#
# Leave BACKEND_URL empty to run in MOCK mode (uses src/lib/mock-data.ts).
# Set BACKEND_URL to your deployed dashboard Worker URL to use real data.
#
# The dashboard Worker is the only public surface of your Cloudflare
# deployment — it owns /login, the session cookie, and proxies /api/* to
# the private backend Worker via a service binding. The Next.js BFF
# proxy in src/app/api/[...path]/route.ts forwards every /api/* call to
# ${BACKEND_URL}/api/* with the session cookie attached.

# URL of your deployed `dashboard` Worker (the public one with /login).
# Examples:
#   https://news-market-ai-dashboard.<your-subdomain>.workers.dev
#   https://dashboard.yourdomain.com
# Leave empty to run in MOCK mode.
BACKEND_URL=

# Dashboard login credentials (server-side only — never exposed to the browser).
# These match DASHBOARD_USERNAME / DASHBOARD_PASSWORD in your wrangler.dashboard.toml.
# Required when BACKEND_URL is set; ignored in MOCK mode.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: override the session cookie name (defaults to "nmai_session",
# matching src/auth/session.js in the original repo).
# NMAI_SESSION_COOKIE=nmai_session

# Existing Prisma DB (not used by the dashboard wiring — kept from scaffold).
DATABASE_URL=file:/home/z/my-project/db/custom.db
