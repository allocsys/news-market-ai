# Local development only. On Cloudflare the DASHBOARD service binding in
# wrangler.jsonc is used instead and none of this is needed.

# Optional: point the BFF at a reachable dashboard Worker (e.g. `wrangler dev`
# of the repo's dashboard Worker). Leave empty for MOCK mode (canned data,
# any login works).
BACKEND_URL=

# Optional, mock mode only: if both are set the mock login checks them.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: session cookie name (must match the dashboard Worker's).
# NMAI_SESSION_COOKIE=nmai_session

# Production safety: mock data is refused in production unless this is 1.
# ALLOW_MOCK=0
