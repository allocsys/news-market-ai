# Copy to .dev.vars for local `wrangler dev` runs. Never commit the real file
# (it's gitignored). In production these are set with `wrangler secret put`.

# Comma-separated -- the Gemini cascade (src/llm/gemini/client.js) rotates
# through all of these on 429/503/network errors before dropping to a
# fallback model. Free-tier keys from separate Google accounts work well here.
GEMINI_API_KEYS=key1,key2,key3

# Optional overrides -- see wrangler.toml [vars] for defaults.
# GEMINI_QUICK_MODEL=gemini-2.5-flash-lite
# GEMINI_DEEP_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# GEMINI_REQUEST_TIMEOUT_MS=30000

# Finnhub news source (src/ingestion/sources/finnhub.js) -- replaced GDELT
# 2026-09-18, see plan.md. Free tier key from https://finnhub.io.
FINNHUB_API_KEY=your-finnhub-key-here
# Optional overrides -- see config.js for defaults.
# FINNHUB_API_BASE=https://finnhub.io/api/v1/company-news
# FINNHUB_MIN_REQUEST_INTERVAL_MS=1100
# FINNHUB_LOOKBACK_DAYS=3

# Required to enable POST /backfill (src/index.js, triggers
# graph/pipeline.js#backfillHistoricalNews). Unset = route stays disabled
# (503) -- this is the safe default, not something to fix. Send it back as
# the X-Backfill-Secret request header to call the route locally, e.g.:
#   curl -X POST "http://localhost:8787/backfill?from=2024-01-01&to=2024-01-31" \
#     -H "X-Backfill-Secret: your-local-secret-here"
BACKFILL_API_SECRET=your-local-secret-here
