{
  "name": "news-market-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "News ingestion -> multi-agent LLM analysis -> trade signal pipeline, deployed on Cloudflare Workers/D1/KV. See plan.md for architecture.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:dashboard": "wrangler dev --config wrangler.dashboard.toml",
    "deploy:dashboard": "wrangler deploy --config wrangler.dashboard.toml",
    "dev:ingest": "wrangler dev --config wrangler.ingest.toml",
    "deploy:ingest": "wrangler deploy --config wrangler.ingest.toml",
    "dev:llm": "wrangler dev --config wrangler.llm.toml",
    "deploy:llm": "wrangler deploy --config wrangler.llm.toml",
    "test": "node --test $(find test -name '*.test.js')",
    "db:migrate:local": "wrangler d1 migrations apply news_market_ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply news_market_ai --remote"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
