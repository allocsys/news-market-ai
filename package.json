{
  "name": "news-market-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "News ingestion -> multi-agent LLM analysis -> trade signal pipeline, deployed on Cloudflare Workers/D1/KV. See plan.md for architecture.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/",
    "db:migrate:local": "wrangler d1 execute news_market_ai --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute news_market_ai --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
